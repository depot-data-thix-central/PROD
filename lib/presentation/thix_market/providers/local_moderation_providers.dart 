  try {
    final res = await client.rpc('is_thix_moderator').timeout(const Duration(seconds: 8));
    return res == true;
  } catch (e) {
    debugPrint('[LocalMod] ⚠️ is_thix_moderator: $e');
    return false;
  }
});

