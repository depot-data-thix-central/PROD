// ----------------------------------------------------------------------------
// NOTIFIER — actions modération
// ----------------------------------------------------------------------------
class LocalModerationNotifier extends StateNotifier<AsyncValue<void>> {
  final Ref _ref;
  LocalModerationNotifier(this._ref) : super(const AsyncValue.data(null));

  SupabaseClient get _client => Supabase.instance.client;
  String? get _uid => _client.auth.currentUser?.id;

  void _invalidateAll() {
    _ref.invalidate(pendingLocalProductsProvider);
    _ref.invalidate(localProductsProvider);
    _ref.invalidate(filteredLocalProductsProvider);
    _ref.invalidate(weeklyProductProvider);
    _ref.invalidate(activeLocalProductsForModProvider);
  }

  Future<String?> _log(String productId, String action, {String? note}) async {
    try {
      await _client.from('product_moderation_logs').insert({
        'product_id': productId,
        'action': action,
        'actor_id': _uid,
        if (note != null) 'note': note,
      });
    } catch (e) {
      debugPrint('[LocalMod] ⚠️ log: $e');
    }
    return null;
  }

  // ── VALIDATION ──
  Future<String?> approve(String productId) async {
    state = const AsyncValue.loading();
    try {
      await _client.from('products').update({
        'status': 'active',
        'updated_at': DateTime.now().toIso8601String(),
      }).eq('id', productId);
      await _log(productId, 'approved');
      _invalidateAll();
      state = const AsyncValue.data(null);
      return null;
    } catch (e) {
      state = AsyncValue.error(e, StackTrace.current);
      return e.toString();
    }
  }

  Future<String?> reject(String productId, String note) async {
    state = const AsyncValue.loading();
    try {
      await _client.from('products').update({
        'status': 'rejected',
        'updated_at': DateTime.now().toIso8601String(),
      }).eq('id', productId);
      await _log(productId, 'rejected', note: note);
      _invalidateAll();
      state = const AsyncValue.data(null);
      return null;
    } catch (e) {
      state = AsyncValue.error(e, StackTrace.current);
      return e.toString();
    }
  }

  // ── PRODUIT DE LA SEMAINE ──
  Future<String?> setWeekly(String productId) async {
    state = const AsyncValue.loading();
    try {
      await _client.from('local_weekly_products').update({'is_active': false}).eq('is_active', true);
      await _client.from('local_weekly_products').insert({
        'product_id': productId,
        'selected_by': _uid,
        'is_active': true,
      });
      await _log(productId, 'weekly_on');
      _ref.invalidate(weeklyProductProvider);
      state = const AsyncValue.data(null);
      return null;
    } catch (e) {
      state = AsyncValue.error(e, StackTrace.current);
      return e.toString();
    }
  }

  Future<String?> clearWeekly() async {
    try {
      await _client.from('local_weekly_products').update({'is_active': false}).eq('is_active', true);
      _ref.invalidate(weeklyProductProvider);
      return null;
    } catch (e) {
      return e.toString();
    }
  }

  // ── CARTES PORTAIL ──
  Future<String?> saveHighlight({
    String? id,
    required String titleFr,
    String? subtitleFr,
    required String icon,
    required String colorHex,
    bool isActive = true,
  }) async {
    state = const AsyncValue.loading();
    try {
      final payload = {
        'title_fr': titleFr,
        'subtitle_fr': subtitleFr ?? '',
        'icon': icon,
        'color': colorHex,
        'is_active': isActive,
      };
      if (id == null) {
        final maxRes = await _client.from('drc_portal_highlights').select('sort_order').order('sort_order', ascending: false).limit(1);
        final next = ((maxRes as List).isEmpty ? 0 : (maxRes.first['sort_order'] as num).toInt() + 1);
        await _client.from('drc_portal_highlights').insert({...payload, 'sort_order': next, 'created_by': _uid});
      } else {
        await _client.from('drc_portal_highlights').update(payload).eq('id', id);
      }
      _ref.invalidate(drcPortalHighlightsProvider);
      state = const AsyncValue.data(null);
      return null;
    } catch (e) {
      state = AsyncValue.error(e, StackTrace.current);
      return e.toString();
    }
  }

  Future<String?> deleteHighlight(String id) async {
    try {
      await _client.from('drc_portal_highlights').delete().eq('id', id);
      _ref.invalidate(drcPortalHighlightsProvider);
      return null;
    } catch (e) {
      return e.toString();
    }
  }

  // ── PRODUCTEUR : créer un produit (toujours PENDING) ──
  Future<String?> createLocalProduct({
    required String shopId,
    required String title,
    required double price,
    required String sectorId,
    int stock = 0,
    String unit = 'pièce',
    String? description,
    String? imageUrl,
  }) async {
    state = const AsyncValue.loading();
    try {
      final res = await _client.from('products').insert({
        'shop_id': shopId,
        'title': title,
        'description': description ?? '',
        'price': price,
        'stock': stock,
        'unit': unit,
        'category': sectorId,
        'is_local': true,
        'status': 'pending', // ✅ visible seulement après approbation
        'image_url': imageUrl,
        'created_at': DateTime.now().toIso8601String(),
      }).select('id').single();
      await _log(res['id'].toString(), 'submitted');
      _ref.invalidate(myLocalProductsProvider);
      _ref.invalidate(pendingLocalProductsProvider);
      state = const AsyncValue.data(null);
      return null;
    } catch (e) {
      state = AsyncValue.error(e, StackTrace.current);
      return e.toString();
    }
  }

  // ── CRÉER UNE COOPÉRATIVE ──
  Future<String?> createCooperative({
    required String name,
    required String city,
    String? logoUrl,
  }) async {
    state = const AsyncValue.loading();
    try {
      await _client.from('shops').insert({
        'owner_id': _uid,
        'name': name,
        'city': city,
        'country': 'CD',
        'type': 'cooperative',
        'is_cooperative': true,
        'is_producer': true,
        'status': 'active',
        'logo_url': logoUrl,
        'created_at': DateTime.now().toIso8601String(),
      });
      _ref.invalidate(localMyShopProvider);
      _ref.invalidate(localCooperativesProvider);
      state = const AsyncValue.data(null);
      return null;
    } catch (e) {
      state = AsyncValue.error(e, StackTrace.current);
      return e.toString();
    }
  }
}

final localModerationProvider =
    StateNotifierProvider<LocalModerationNotifier, AsyncValue<void>>((ref) => LocalModerationNotifier(ref));
