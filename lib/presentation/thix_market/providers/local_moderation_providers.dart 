// CARTES DU PORTAIL (remplacent les 4 piliers)
// ----------------------------------------------------------------------------
class PortalHighlight {
  final String id;
  final String titleFr, titleEn, titleSw;
  final String subtitleFr, subtitleEn, subtitleSw;
  final String icon;
  final String? imageUrl;
  final String colorHex;
  final int sortOrder;
  final bool isActive;

  const PortalHighlight({
    required this.id,
    required this.titleFr,
    this.titleEn = '',
    this.titleSw = '',
    required this.subtitleFr,
    this.subtitleEn = '',
    this.subtitleSw = '',
    required this.icon,
    this.imageUrl,
    required this.colorHex,
    required this.sortOrder,
    required this.isActive,
  });

  String title(String lang) {
    final v = lang == 'en' ? titleEn : lang == 'sw' ? titleSw : titleFr;
    return v.trim().isEmpty ? titleFr : v;
  }

  String subtitle(String lang) {
    final v = lang == 'en' ? subtitleEn : lang == 'sw' ? subtitleSw : subtitleFr;
    return v.trim().isEmpty ? subtitleFr : v;
  }

  Color get color {
    try {
      return Color(int.parse(colorHex.replaceFirst('#', ''), radix: 16) | 0xFF000000);
    } catch (_) {
      return kDrcBlue;
    }
  }
}

IconData portalHighlightIcon(String key) {
  switch (key) {
    case 'verified':
      return Icons.verified_rounded;
    case 'handshake':
      return Icons.handshake_rounded;
    case 'truck':
      return Icons.local_shipping_rounded;
    case 'eco':
      return Icons.eco_rounded;
    case 'star':
      return Icons.star_rounded;
    case 'store':
      return Icons.storefront_rounded;
    default:
      return Icons.flag_rounded;
  }
}

final drcPortalHighlightsProvider = FutureProvider.autoDispose<List<PortalHighlight>>((ref) async {
  try {
    final res = await Supabase.instance.client
        .from('drc_portal_highlights')
        .select('*')
        .eq('is_active', true)
        .order('sort_order', ascending: true)
        .limit(12)
        .timeout(const Duration(seconds: 8));
    return (res as List).map((e) {
      final m = Map<String, dynamic>.from(e);
      return PortalHighlight(
        id: m['id']?.toString() ?? '',
        titleFr: m['title_fr']?.toString() ?? '',
        titleEn: m['title_en']?.toString() ?? '',
        titleSw: m['title_sw']?.toString() ?? '',
        subtitleFr: m['subtitle_fr']?.toString() ?? '',
        subtitleEn: m['subtitle_en']?.toString() ?? '',
        subtitleSw: m['subtitle_sw']?.toString() ?? '',
        icon: m['icon']?.toString() ?? 'flag',
        imageUrl: m['image_url']?.toString(),
        colorHex: m['color']?.toString() ?? '#1E6FD9',
        sortOrder: (m['sort_order'] as num?)?.toInt() ?? 0,
        isActive: m['is_active'] == true,
      );
    }).toList();
  } catch (e) {
    debugPrint('[LocalMod] ⚠️ highlights: $e');
    return const [];
  }
});

// ----------------------------------------------------------------------------
// ✅ COOPÉRATIVES UNIQUEMENT (page Producteurs + home)
// ----------------------------------------------------------------------------
final localCooperativesProvider = FutureProvider.autoDispose<List<Map<String, dynamic>>>((ref) async {
  try {
    final res = await Supabase.instance.client
        .from('shops')
        .select('*, products(count)')
        .eq('is_cooperative', true)
        .order('name', ascending: true)
        .limit(50)
        .timeout(const Duration(seconds: 10));
    return (res as List).map((e) {
      final m = Map<String, dynamic>.from(e);
      final counts = m['products'];
      int count = 0;
      if (counts is List && counts.isNotEmpty) {
        count = (counts.first['count'] as num?)?.toInt() ?? 0;
      }
      m['local_count'] = count;
      return m;
    }).toList();
  } catch (e) {
    debugPrint('[LocalMod] ⚠️ cooperatives: $e');
    return const [];
  }
});

